# Origens do front permitidas pelo CORS, separadas por vírgulas.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Fonte da Gold lida pela API: seed (dados fictícios) ou real (CSVs importados de data/gold).
GOLD_SOURCE=seed

# PostgreSQL. O docker-compose.yml lê estas variáveis para criar o banco.
POSTGRES_USER=vgrid
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=vgrid360
POSTGRES_PORT=5432

# Porta da API no host (docker compose).
API_PORT=8000

# Conexão usada pelo backend fora do Docker (no compose, a API usa o host "postgres").
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}

# Usuário somente leitura do assistente de IA. Defina uma senha própria no .env (nunca no Git).
AGENTE_DB_USER=vgrid_agente
AGENTE_DB_PASSWORD= jayson_rock
# Opcional: só preencha se o agente precisar de outro host ou banco.
DATABASE_URL_AGENTE=

# Assistente de IA (POST /ia). IA_MODO=mock usa respostas simuladas; real chama o agente da Equipe 3.
IA_MODO=mock
# Segundos de espera pelo agente antes de responder AGENTE_INDISPONIVEL.
IA_TIMEOUT_S=30
# Endereço e chave do agente real. A chave fica só no .env (nunca no Git).
IA_AGENTE_URL=
IA_API_KEY=
# Módulo de insight da Equipe 3 (Tela 2). Se falhar ou ficar vazio, a API devolve um texto alternativo.
IA_INSIGHT_URL=

# Configuração do provedor e modelo LLM via PydanticAI (GENAI-1).
# Provedores suportados: openrouter, google, openai, groq, test
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL_NAME=nvidia/nemotron-3.5-lightning:free
LLM_PROVIDER=openrouter
# Ex.: nvidia/nemotron-3.5-lightning:free, google/gemini-2.5-flash-lite, gemini-2.5-flash-lite
LLM_MODELO=
# Se vazio, reaproveita OPENROUTER_API_KEY, IA_API_KEY ou GEMINI_API_KEY. Nunca commitar chaves reais.
LLM_API_KEY=
# URL base opcional para provedores compatíveis com OpenAI (ex.: https://openrouter.ai/api/v1)
LLM_BASE_URL=
# Temperatura opcional (se vazio: 1.0 para família Gemini 3; 0.0 para SQL e 0.2 para insight nos demais)
LLM_TEMPERATURA=
# Timeout por chamada ao provedor em segundos (menor que IA_TIMEOUT_S)
LLM_TIMEOUT_S=25
