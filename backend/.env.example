# Origens do front permitidas pelo CORS, separadas por vírgulas.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GOLD_SOURCE=real

# PostgreSQL. O docker-compose.yml lê estas variáveis para criar o banco.
POSTGRES_USER=vgrid
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=vgrid360
POSTGRES_PORT=5432

# Porta da API no host (docker compose).
API_PORT=8000

# Conexão usada pelo backend fora do Docker (no compose, a API usa o host "postgres").
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}
