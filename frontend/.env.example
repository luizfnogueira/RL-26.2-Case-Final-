# URL base da API FastAPI (sem barra no final).
VITE_API_URL=http://localhost:8000

# true: usa mocks rotulados nos dados de negócio. Autenticação sempre exige a API.
# false: consulta também os dados de negócio na API em VITE_API_URL.
VITE_USE_MOCKS=false

# Atraso artificial dos mocks, em milissegundos, para exercitar os estados de carregamento.
VITE_MOCK_DELAY_MS=350
