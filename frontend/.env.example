# URL base da API FastAPI (sem barra no final).
VITE_API_URL=http://localhost:8000

# true: o front usa mocks rotulados como fictícios e roda sem backend.
# false: o front chama a API em VITE_API_URL.
VITE_USE_MOCKS=true

# Atraso artificial dos mocks, em milissegundos, para exercitar os estados de carregamento.
VITE_MOCK_DELAY_MS=350
